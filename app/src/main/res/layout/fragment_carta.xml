<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.BottomNavigation.CartaFragment"
    android:background="@color/white">

    <!-- TODO: Update blank fragment layout -->


    <ImageView
        android:id="@+id/lienso"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/lienso_que_va_debajo_del_logo"
        android:contentDescription="TODO"
        tools:ignore="ContentDescription,HardcodedText,ImageContrastCheck" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="111dp"
        android:layout_height="59dp"
        android:contentDescription="@string/imagen_encima_del_lienzo"
        android:src="@drawable/logo_lamafia_1"
        android:layout_marginStart="140dp"
        android:layout_marginTop="45dp"

        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageButton
            android:id="@+id/buttonOpenWebsite"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/baseline_flatware_24"
            android:background="@drawable/button_border"
            android:contentDescription="@string/abrir_carta"
            android:scaleType="fitCenter"
            tools:ignore="ImageContrastCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/abrir_carta"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


</FrameLayout>